<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/arcane_ripple_purple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="@color/arcane_surface_alt"
                android:endColor="@color/arcane_surface"
                android:angle="90" />
            <stroke
                android:width="1.2dp"
                android:color="@color/arcane_accent_purple" />
            <padding
                android:left="12dp"
                android:top="10dp"
                android:right="12dp"
                android:bottom="10dp" />
        </shape>
    </item>
</ripple>