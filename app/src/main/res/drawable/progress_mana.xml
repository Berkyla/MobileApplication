<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/arcane_surface_alt" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/arcane_divider" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <gradient
                    android:startColor="@color/arcane_mana_border"
                    android:endColor="@color/arcane_mana_blue"
                    android:angle="90" />
            </shape>
        </clip>
    </item>
</layer-list>